[Unit]
Description=Backup T Chat data (chat.json + media) to Cloudflare R2

# Note: setup-all.sh writes this unit automatically with the correct
# $INSTALL_DIR (on the VPS: /opt/tukuk-os). This file is reference only — avoid double-backup,
# install manually only if you do NOT use setup-all.sh.
[Service]
Type=oneshot
User=tukuk
WorkingDirectory=/opt/tukuk-os
EnvironmentFile=/home/tukuk/.config/tukuk-os/r2.env
ExecStart=/bin/bash /opt/tukuk-os/scripts/backup-chat.sh
