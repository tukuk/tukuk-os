[Unit]
Description=Meilisearch (Tukuk-OS search engine)
Documentation=https://www.meilisearch.com/docs
After=network-online.target
Wants=network-online.target
# Restart forever, without limits
StartLimitIntervalSec=0

[Service]
Type=simple
# setup-all.sh writes the live unit with $INSTALL_DIR substituted; this copy is the shape.
# The master key is READ from .env — never interpolated into ExecStart. Interpolating it
# leaves the secret world-readable in /etc/systemd/system and freezes it, so a rotated .env
# stops matching and every search falls back to the 30-document mock with no visible fault.
EnvironmentFile=-/opt/tukuk-os/.env
# Same unprivileged user as tukuk-os.service (setup-all.sh [3b]). A root-run index engine
# is a second, equally silent way to lose the box: it holds an HTTP API and a master key.
User=tukuk-os
Group=tukuk-os
# Where meilisearch puts files that are NOT under --db-path. systemd defaults the
# working directory to /, and ProtectSystem=strict makes / read-only, so without this
# line meilisearch exits at once with "Read-only file system (os error 30)" and
# Restart=always spins forever: verified on a rebuilt box, 30 Oct 2026, restart counter
# 52 while /health reported "meilisearch":"unreachable". It is not a db-path permission
# problem — the same command started cleanly once its cwd was inside a writable dir.
WorkingDirectory=/opt/tukuk-os/meili_data
ExecStart=/usr/local/bin/meilisearch --db-path /opt/tukuk-os/meili_data --master-key ${MEILI_MASTER_KEY} --http-addr 127.0.0.1:7700

Restart=always
RestartSec=3
RestartForceExitStatus=SIGABRT

MemoryMax=2G
TasksMax=256
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meilisearch

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/tukuk-os/meili_data

[Install]
WantedBy=default.target