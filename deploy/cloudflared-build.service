[Unit]
# Connector cloudflared KEDUA — tunnel legacy build-tukuk (build.tukuk.org →
# 127.0.0.1:5174 Tukuk Builder). Tunnel utama berjenis remote-config jadi
# hostname baharu tak boleh ditambah lewat ingress lokal; lihat
# deploy/cloudflared/config-build.example.yml untuk langkah provisioning.
Description=cloudflared Tunnel kedua - build.tukuk.org (legacy mode, ingress lokal)
After=network-online.target
Wants=network-online.target

[Service]
# --protocol http2: lalai 'auto' pakai QUIC/UDP yang kerap timeout pada rangkaian
# VPS ini (lihat 'Failed to dial a quic connection'), menyebabkan build.tukuk.org
# sesekali tak dapat dibuka. HTTP/2 atas TCP/443 lebih teguh.
ExecStart=/usr/bin/cloudflared --no-autoupdate --protocol http2 --config /etc/cloudflared/config-build.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
