[Unit]
Description=Tukuk-OS Search Engine & Open Agent Web
After=network-online.target meilisearch.service
Wants=network-online.target meilisearch.service
# NOT Requires/PartOf — if Meilisearch dies, search engine MUST stay alive
# to still answer from fallback cache (see src/fallback.js).
StartLimitIntervalSec=0

[Service]
Type=simple
User=tukuk
WorkingDirectory=/opt/tukuk-os
EnvironmentFile=/opt/tukuk-os/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/tukuk-os/index.js

# --- Never stay dead ---
Restart=always
RestartSec=3
# Cap memory usage so the OOM killer does not kill the service
MemoryMax=1G
TasksMax=512

# Force restart after an unclean signal
RestartForceExitStatus=SIGABRT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-os

# --- hardening (does not block functionality) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/tukuk-os/meili_data /opt/tukuk-os/snapshots /opt/tukuk-os/dumps

[Install]
WantedBy=multi-user.target