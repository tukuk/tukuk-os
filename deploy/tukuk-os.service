[Unit]
Description=Tukuk-OS search engine (Express + Meilisearch)
Documentation=https://github.com/meilisearch/meilisearch
After=network-online.target meilisearch.service
Wants=network-online.target meilisearch.service
# NOT Requires/PartOf — if Meilisearch dies, the search engine MUST stay alive
# to still answer from the fallback cache (see src/fallback.js).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/tukuk/tukuk-os
EnvironmentFile=/home/tukuk/.config/tukuk-os/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node index.js

# --- Never stay dead ---
Restart=always
RestartSec=3
# Cap memory usage so the OOM killer does not kill the service
MemoryMax=1G
TasksMax=512

# Force restart after an unclean signal
RestartForceExitStatus=SIGABRT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-os

# --- hardening (does not block functionality) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/tukuk/tukuk-os/meili_data /home/tukuk/tukuk-os/snapshots /home/tukuk/tukuk-os/dumps

[Install]
WantedBy=default.target