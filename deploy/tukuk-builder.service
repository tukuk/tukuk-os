[Unit]
# Tukuk Builder — fork bolt.diy: pembina aplikasi AI berjenama Tukuk.
# HIDANG DI DUA HOSTNAME (dua-duanya live):
#   build.tukuk.org — tunnel LEGACY kedua (cloudflared-build.service; lihat
#     deploy/cloudflared/config-build.example.yml — tunnel utama berjenis
#     remote-config, hostname baharu MUSTAHIL lewat ingress lokal)
#   dashboard.tukuk.org — remote-config tunnel utama; peraturan laluan
#     /admin & /api kekal ke port 3000.
# WebContainer memerlukan header COOP/COEP yang ditetapkan entry.server.tsx —
# di bawah tukuk.org ia berlanggar dengan CSP sedia ada, sebab itu hostname
# berasingan.
# Vite menolak Host luar senarai: preview/server.allowedHosts=['.tukuk.org']
# dalam vite.config.ts (fork tukuk-builder commit 9e769c4) — jangan dibuang.
Description=Tukuk Builder (fork bolt.diy — agen pembinaan aplikasi AI)
Documentation=https://github.com/fevian448/tukuk-builder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/tukuk-builder
EnvironmentFile=-/opt/tukuk-builder/.env.production
Environment=NODE_ENV=production
# Pola rasmi bolt.diy: `vite preview` menghidang SSR build (build/server) —
# dipandu terus ke binary vite supaya tidak perlu pnpm dalam unit systemd.
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 5174 --strictPort

Restart=always
RestartSec=3
# Bina & hidang SPA berat — beri ruang tapi berbatas (pelayan 6.8G jumlah).
MemoryMax=2G
TasksMax=1024

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-builder

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
