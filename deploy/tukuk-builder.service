[Unit]
# Tukuk Builder — a bolt.diy fork: a Tukuk-branded AI app builder.
# ONE CANONICAL HOST: build.tukuk.org (a route on the single cloudflared tunnel).
#   It used to be reachable on dashboard.tukuk.org too, and that host is now RETIRED: it shared
#   the apex app's `/api` namespace, so a builder page served there called Tukuk-OS's `/api/models`,
#   `/api/chat`, `/api/configured-providers` and died on the reply shape
#   ("TypeError: r is not iterable" -> Application Error). Every alias-host page was 308'd to
#   build.tukuk.org as a patch; with the hostname gone the redirect has nothing left to catch.
# WebContainer needs the COOP/COEP headers set by entry.server.tsx —
# under tukuk.org they clash with the existing CSP, hence a separate
# hostname.
# Vite rejects Hosts outside its list: preview/server.allowedHosts=['.tukuk.org']
# in vite.config.ts (fork tukuk-builder commit 9e769c4) — do not remove it.
# PORT 5176, NOT 5174: the always-on front door (tukuk-builder-wake.service) owns 5174 because
# that is the port cloudflared is configured to reach. It forwards here, and wakes this unit when
# it has been asleep. Do not move this back to 5174 or the two units will fight for the socket.
Description=Tukuk Builder (bolt.diy fork — AI app-building agent)
Documentation=https://github.com/fevian448/tukuk-builder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# ONE FOLDER. The Builder used to live at /opt/tukuk-builder, a second top-level directory
# that every script, backup and rebuild step had to remember separately. It is a subdirectory
# of the app now, so /opt/tukuk-os is the only path on this box that needs to be known.
# The old location is a compatibility symlink until scripts/consolidate-layout.sh
# --prune-links runs; deploy/paths.sh is what the scripts read instead of either literal.
WorkingDirectory=/opt/tukuk-os/apps/builder
EnvironmentFile=-/opt/tukuk-os/apps/builder/.env.production
Environment=NODE_ENV=production
# bolt.diy's official pattern: `vite preview` serves the SSR build (build/server) —
# pointed straight at the vite binary so pnpm is not needed inside the systemd unit.
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 5176 --strictPort

Restart=always
RestartSec=3
# Build & serve a heavy SPA — give room but bounded (6.8G server total).
MemoryMax=2G
TasksMax=1024

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-builder

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
