[Unit]
# Tukuk Builder — a bolt.diy fork: a Tukuk-branded AI app builder.
# ONE CANONICAL HOST: build.tukuk.org (the legacy cloudflared-build connector).
#   dashboard.tukuk.org is an ALIAS: the main remote-config tunnel keeps `/admin` and `/api/*`
#   on port 3000 for Tukuk-OS, so a builder served from that host is handed the wrong
#   `/api/models`, `/api/chat`, `/api/configured-providers` and dies on the reply shape
#   ("TypeError: r is not iterable" -> Application Error). The always-on front door on :5174
#   (builder-wakekeeper.js) therefore 308s every alias-host page to build.tukuk.org; only
#   /admin and /api on that hostname stay with Tukuk-OS.
# WebContainer needs the COOP/COEP headers set by entry.server.tsx —
# under tukuk.org they clash with the existing CSP, hence a separate
# hostname.
# Vite rejects Hosts outside its list: preview/server.allowedHosts=['.tukuk.org']
# in vite.config.ts (fork tukuk-builder commit 9e769c4) — do not remove it.
# PORT 5176, NOT 5174: the always-on front door (tukuk-builder-wake.service) owns 5174 because
# that is the port cloudflared is configured to reach. It forwards here, and wakes this unit when
# it has been asleep. Do not move this back to 5174 or the two units will fight for the socket.
Description=Tukuk Builder (bolt.diy fork — AI app-building agent)
Documentation=https://github.com/fevian448/tukuk-builder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/tukuk-builder
EnvironmentFile=-/opt/tukuk-builder/.env.production
Environment=NODE_ENV=production
# bolt.diy's official pattern: `vite preview` serves the SSR build (build/server) —
# pointed straight at the vite binary so pnpm is not needed inside the systemd unit.
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 5176 --strictPort

Restart=always
RestartSec=3
# Build & serve a heavy SPA — give room but bounded (6.8G server total).
MemoryMax=2G
TasksMax=1024

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-builder

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
