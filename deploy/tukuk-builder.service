[Unit]
# Tukuk Builder — a bolt.diy fork: a Tukuk-branded AI app builder.
# SERVED ON TWO HOSTNAMES (both live):
#   build.tukuk.org — the LEGACY second tunnel (cloudflared-build.service; see
#     deploy/cloudflared/config-build.example.yml — the main tunnel is
#     remote-config type, a new hostname is IMPOSSIBLE via a local ingress)
#   dashboard.tukuk.org — the main remote-config tunnel; the /admin & /api route
#     rules stay pointed at port 3000.
# WebContainer needs the COOP/COEP headers set by entry.server.tsx —
# under tukuk.org they clash with the existing CSP, hence a separate
# hostname.
# Vite rejects Hosts outside its list: preview/server.allowedHosts=['.tukuk.org']
# in vite.config.ts (fork tukuk-builder commit 9e769c4) — do not remove it.
Description=Tukuk Builder (bolt.diy fork — AI app-building agent)
Documentation=https://github.com/fevian448/tukuk-builder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/tukuk-builder
EnvironmentFile=-/opt/tukuk-builder/.env.production
Environment=NODE_ENV=production
# bolt.diy's official pattern: `vite preview` serves the SSR build (build/server) —
# pointed straight at the vite binary so pnpm is not needed inside the systemd unit.
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 5174 --strictPort

Restart=always
RestartSec=3
# Build & serve a heavy SPA — give room but bounded (6.8G server total).
MemoryMax=2G
TasksMax=1024

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-builder

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
