# /opt/tukuk-builder/.env.production — environment perkhidmatan Tukuk Builder.
# Nilai TUKUK_API_KEY MESTI sama dengan AGENT_TOKEN dalam /opt/tukuk-os/.env.
# Panggilan agen melalui loopback — tanpa keluar pelayan, tanpa had CORS.
TUKUK_API_BASE_URL=http://127.0.0.1:3000/api/agent/v1
TUKUK_API_KEY=tampal-agent-token-disini

# Ollama setempat di pelayan (pilihan — hidupkan bila ollama serve berjalan)
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
