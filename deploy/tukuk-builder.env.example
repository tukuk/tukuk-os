# /opt/tukuk-os/apps/builder/.env.production — service environment for Tukuk Builder.
# (It used to be /opt/tukuk-builder/.env.production; the Builder now lives inside the app
# folder — see deploy/paths.sh and scripts/consolidate-layout.sh.)
# A Builder served from this box talks to its own loopback proxy, so it can use the real
# AGENT_TOKEN from /opt/tukuk-os/.env (full tier). Paste the VALUE into this file on the
# server — never commit a file that holds it: tukuk-builder/.env.production is tracked,
# and test/secret-hygiene.test.js fails the build when a private value appears in git.
# The token compiled into the public browser bundle is the different one, AGENT_FREE_TOKEN.
# Agent calls go through loopback — never leaves the server, no CORS limits.
TUKUK_API_BASE_URL=http://127.0.0.1:3000/api/agent/v1
TUKUK_API_KEY=paste-agent-token-here

# Local Ollama on the server (optional — enable when ollama serve is running)
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
