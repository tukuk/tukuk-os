# ==============================================================================
# env.defaults — konfigurasi server terbawa (REPO PRIVATE SAHAJA).
# setup-all.sh menyalin fail ini ke .env secara automatik di pelayan baru,
# supaya `npm install` sahaja cukup — tiada editing manual.
# ⚠️ JANGAN push fail ini ke repo AWAM.
# ==============================================================================

# ── Admin (e-mel + passkey) ───────────────────────────────────────────────────
ADMIN_EMAIL=fevianbenjo48@gmail.com
ADMIN_PASSWORD=940724Bien@
ADMIN_SESSION_TTL_MS=28800000

# ── WebAuthn ──────────────────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Tukuk-OS Admin
WEBAUTHN_RP_ID=tukuk.org
WEBAUTHN_ORIGIN=https://tukuk.org,https://www.tukuk.org,https://dashboard.tukuk.org

# ── IndexNow (traffic: Bing/Yandex/Naver/Seznam dapat URL serta-merta) ───────
# Kunci dihos public di https://tukuk.org/<KEY>.txt (fail public/bd8f0317…txt).
# 1 = setiap artikel baharu yang diterbitkan dari /admin terus dihantar ke IndexNow.
INDEXNOW_ENABLED=1
INDEXNOW_KEY=bd8f0317c5ab4cddb9a3dc62f7ec15ae

# ── Cloudflare Tunnel (mod TOKEN — disyorkan, tanpa fail credentials) ────────
# Token di bawah ialah token tunnel SEJATI "tukuk-os-v2" (UUID 87e7e77f…).
# Cara dapat semula (jika perlu): cloudflared tunnel token <UUID> (guna cert.pem).
# setup-all.sh MOD TOKEN menulis config.yml (token + ingress) dari templat
# deploy/cloudflared/config.yml — INGRESS tukuk.org / www / dashboard sudah ada
# di situ, jadi TIADA perlu buat "Public Hostname" di dashboard.
# Lepas ini, SETIAP server baru cukup bawa kod (USB/push) + `npm install` sahaja
# — tunnel hidup automatik, tiada fail .json, tiada auth GitHub.
CF_TUNNEL_TOKEN=eyJhIjoiMzkxZDlhYTU5Y2ZjYzVlYzQ0YzNkMjVjODU1YzQ1Y2IiLCJzIjoiQmZQR2EvMUJ3cXEyUHNTNkcySm1NK2pFTTVnVVJHNDBFMHUwNVBQMERJQT0iLCJ0IjoiODdlN2U3N2YtZDZlMC00MTBiLWJiY2ItZGQ3NGFlM2E0OWFlIn0=
# (Mod lama bernama perlukan fail <uuid>.json — tunnel 168a53af... sudah
#  lumpuh sebab credentials hilang apabila server lama dipadam.)
CF_TUNNEL_ID=87e7e77f-d6e0-410b-bbcb-dd74ae3a49ae

# ── Cloudflare API (untuk wrangler: worker www + snapshot R2) ───────────────
# Token: My Profile → API Tokens → Create (template "Edit cloudflare Workers &
# Pages" + tambah kebenaran R2 & Zone DNS). Isi sekali → setiap `npm install`
# auto-deploy worker & aktifkan timer snapshot 6 jam.
CLOUDFLARE_API_TOKEN=cfut_a1ckoGQ9zkU9Z38wbGFaYKWVChiMXnmtmKNuKLega8f7d23d

# ── Tukuk Agent (/api/agent/* proksi tool-calling + build API) ───────────────
# AGENT_TOKEN = Bearer yang dipakai pelanjutan Cline dalam Tukuk Agent untuk
# memanggil https://tukuk.org/api/agent/v1. Ganti nilai rawak di bawah sebelum
# deploy (jangan guna token contoh ini). Admin passkey sesi juga diterima.
AGENT_TOKEN=041a0832ab912f44e1814d326ac481e24c5928bc6e8c7089c043ea40cc32618d
# Asal editor (agent.tukuk.org) yang dibenarkan CORS memanggil tukuk.org.
AGENT_ORIGIN=https://agent.tukuk.org
# AGENT_FREE_TOKEN = penanda tier PERCUMA untuk Tukuk Builder (build.tukuk.org).
# Nilai ini SENGAJA token awam yang sudah terbit di GitHub fork (providers/
# tukuk.ts) — bukan rahsia; perlindungannya had kadar ketat (default 8/min/IP)
# + kekangan max_tokens (default 16384), bukan kerahsiaan token. Kos sebenar =
# kuota cloud rotasi kita; tapisan ini menghalang hisapan besar-besaran.
AGENT_FREE_TOKEN=041a0832ab912f44e1814d326ac481e24c5928bc6e8c7089c043ea40cc32618d
# AGENT_FREE_RATE_PER_MIN=8
# AGENT_FREE_MAX_TOKENS=16384
# LLM_CLOUD_ORDER = susunan rotasi pembekal untuk AGEN builder (hanya yang
# kind:'openai' + sokong tools dipakai; gemini/cloudflare/litert di-langgau).
# Lalai luas (letak openai berbayar sbg sandaran akhir):
#   groq,gemini,ollama-cloud,openrouter,xai,huggingface,cloudflare,openai,litert
# Untuk uji Tukuk Builder PERCUMA-SAHAJA (RM0 dijamin — buang openai berbayar):
#   LLM_CLOUD_ORDER=groq,openrouter,huggingface
# Nota: pada pelayan produksi tukuk.org, nilai ini sudah dikunci ke
# groq,openrouter,huggingface supaya tier percuma Groq/OpenRouter/HF sahaja.
# LLM_CLOUD_ORDER=groq,gemini,ollama-cloud,openrouter,xai,huggingface,cloudflare,openai,litert

# ── Git branch yang digunakan di server ──────────────────────────────────────
GIT_BRANCH=main
# Auto-update harian (~04:30) di SEMUA server: git pull → npm install →
# servis + worker + snapshot dikemas sekali jalan. Set 0 untuk matikan.
GIT_AUTO_UPDATE=1
