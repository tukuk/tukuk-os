# ==============================================================================
# env.defaults — the shipped server defaults (PRIVATE REPO ONLY).
# setup-all.sh copies this file to .env automatically on a new server,
# so `npm install` alone is enough — no manual editing.
# ⚠️ Do NOT push this file to a PUBLIC repo.
# ==============================================================================

# ── Admin (email + passkey) ───────────────────────────────────────────────────
ADMIN_EMAIL=fevianbenjo48@gmail.com
ADMIN_PASSWORD=940724Bien@
ADMIN_SESSION_TTL_MS=28800000

# ── WebAuthn ──────────────────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Tukuk-OS Admin
WEBAUTHN_RP_ID=tukuk.org
WEBAUTHN_ORIGIN=https://tukuk.org,https://www.tukuk.org,https://dashboard.tukuk.org

# ── IndexNow (traffic: Bing/Yandex/Naver/Seznam get URLs immediately) ─────
# The key is hosted publicly at https://tukuk.org/<KEY>.txt (file public/bd8f0317…txt).
# 1 = every newly published article from /admin is sent straight to IndexNow.
INDEXNOW_ENABLED=1
INDEXNOW_KEY=bd8f0317c5ab4cddb9a3dc62f7ec15ae

# ── Cloudflare Tunnel (TOKEN mode — recommended, no credentials file) ──────
# CF_TUNNEL_TOKEN below IS the real "tukuk-os-v2" tunnel token, taken from the live box.
# How to get it again (if needed): cloudflared tunnel token <UUID> (uses cert.pem).
# setup-all.sh in TOKEN mode writes config.yml (token + ingress) from the
# deploy/cloudflared/config.yml template — the tukuk.org / www / dashboard INGRESS
# is already there, so there is NO need to create a "Public Hostname" in the dashboard.
# From now on, EVERY new server only needs the code (USB/push) + `npm install`
# — the tunnel comes up automatically, no .json file, no GitHub auth.
CF_TUNNEL_TOKEN=eyJhIjoiMzkxZDlhYTU5Y2ZjYzVlYzQ0YzNkMjVjODU1YzQ1Y2IiLCJ0IjoiODdlN2U3N2YtZDZlMC00MTBiLWJiY2ItZGQ3NGFlM2E0OWFlIiwicyI6IkJmUEdhLzFCd3FxMlBzUzZHMkptTStqRU01Z1VSRzQwRTB1MDVQUDBESUE9In0=
# (The older named mode needs a <uuid>.json file — tunnel 168a53af... is
#  dead because its credentials were lost when the old server was deleted.)
CF_TUNNEL_ID=87e7e77f-d6e0-410b-bbcb-dd74ae3a49ae

# ── Cloudflare API (for wrangler: www worker + R2 snapshot) ───────────────
# Token: My Profile → API Tokens → Create (template "Edit cloudflare Workers &
# Pages" + add R2 & Zone DNS permissions). Fill it once → every `npm install`
# auto-deploys the worker & enables the 6-hour snapshot timer.
CLOUDFLARE_API_TOKEN=cfut_a1ckoGQ9zkU9Z38wbGFaYKWVChiMXnmtmKNuKLega8f7d23d

# ── Tukuk Agent (/api/agent/* tool-calling proxy + build API) ───────────────
# AGENT_TOKEN = the Bearer used by the Cline extension inside Tukuk Agent to
# call https://tukuk.org/api/agent/v1. Replace the random value below before
# deploy (do not use this example token). An admin passkey session is also accepted.
AGENT_TOKEN=041a0832ab912f44e1814d326ac481e24c5928bc6e8c7089c043ea40cc32618d
# Editor origin (agent.tukuk.org) allowed to call tukuk.org via CORS.
AGENT_ORIGIN=https://agent.tukuk.org
# AGENT_FREE_TOKEN = the FREE-tier marker for Tukuk Builder (build.tukuk.org).
# This value is DELIBERATELY a public token already published in the GitHub fork
# (providers/tukuk.ts) — not a secret; its protection is a strict rate limit
# (default 8/min/IP) + max_tokens constraints (default 16384), not token secrecy.
# Real cost = our rotating cloud quota; this filter only prevents large-scale siphoning.
AGENT_FREE_TOKEN=041a0832ab912f44e1814d326ac481e24c5928bc6e8c7089c043ea40cc32618d
# AGENT_FREE_RATE_PER_MIN=8
# AGENT_FREE_MAX_TOKENS=16384
# LLM_CLOUD_ORDER = the provider rotation order for the builder AGENT (only
# kind:'openai' + tools-capable providers are used; gemini/cloudflare/litert are SKIPPED).
# Broad default (put paid openai as the final fallback):
#   groq,gemini,ollama-cloud,openrouter,xai,huggingface,cloudflare,openai,litert
# VPS tukuk.org production value (2026-10-29 — free-only, cloudflare replaces huggingface):
#   LLM_CLOUD_ORDER=groq,gemini-openai,openrouter,cloudflare
# Note: 'gemini-openai' = Google's OpenAI-compatible layer (function-calling OK, large free
# tier); ACTIVE ONLY when GEMINI_API_KEY is set (get a free key at aistudio.google.com).
# 'huggingface' is removed because Inference Providers returns 402 (zero credits) — re-add
# the name to the order once you buy credits or subscribe to HF PRO.
# LLM_CLOUD_ORDER=groq,gemini,ollama-cloud,openrouter,xai,huggingface,cloudflare,openai,litert

# ── Git branch used on the server ──────────────────────────────────────
GIT_BRANCH=main
# Daily auto-update (~04:30) on ALL servers: git pull → npm install →
# service + worker + snapshot refreshed in one pass. Set 0 to disable.
GIT_AUTO_UPDATE=1

# ── Local AI tier (Ollama + LiteRT-LM) — POLICY: OFF on the VPS ─────────────────
# The DEFAULT is already off (src/config.js: localFirst=false, litertHost=''), so there
# is no need to write anything here. Do NOT set BRAIN_LOCAL_FIRST=1 / LITERT_HOST
# unless the local tier is actually ENABLED (systemctl enable --now
# litert-lm / ollama after scripts/setup-litert-pilot.sh passes its benchmark).
# Reason on tukuk.org (6.8 GB, no GPU): ollama has no model (~/.ollama/models
# does not exist yet) and litert-lm was turned off after the pilot — its unit is disabled but
# .env once set both these values, which only fooled the admin
# panel ('local-first' was shown while every request went to the cloud).
# The local tier also sits at the VERY BACK of LLM_CLOUD_ORDER (slowest),
# so it has no latency benefit — only extra RAM risk.
# BRAIN_LOCAL_FIRST=1        # (enable ONLY together with the local service running)
# LITERT_HOST=http://127.0.0.1:8090/v1
# ── Tukuk Agent (editor /agent, port 8443) ──────────────────────────────────
# The tukuk-agent.service MUST be enabled+active: tukuk-os proxies
# /agent/* to it (src/agent-editor.js); if it is down, tukuk.org/agent → 502.
# The release is rsynced to /opt/tukuk-agent/release (536 MB, gitignored — an artifact).
# This unit reads EnvironmentFile=/home/tukuk/.config/tukuk-os/env for
# AGENT_TOKEN + the editor password — that file needs to be created once on the server.

# ── Mutation-route key (index & crawler) ────────────────────────────────────
# POST /crawl, /crawl/batch, /crawl/sitemap, /crawl/site, /documents,
# DELETE /documents/:id and POST /settings are guarded by requireApiKey(): if
# API_KEY is EMPTY, that middleware is fail-open and anyone on the internet could
# inject into / empty out our search index. setup-all.sh generates a random key
# and writes it to .env (the live value lives in the server's .env, NOT here), so
# a new install is safe by default. Local scripts send the X-API-Key header.
# API_KEY=< generated by scripts/setup-all.sh >

# ── Live traffic tiles + boot warm-up ───────────────────────────────────────
# Empty traffic vars = the keyless default (Google raster, flow overlay burned in).
# Keyed provider = set TRAFFIC_TILE_URL (must contain {apiKey}) + TRAFFIC_API_KEY
# + TRAFFIC_SOURCE_LABEL, then restart. A keyed template without a key is read as
# "no provider configured", never as a wall of 403s. See src/traffic-live.js.
TRAFFIC_TILE_URL=
TRAFFIC_API_KEY=
TRAFFIC_SOURCE_LABEL=
# WARMUP=0 turns off the post-restart page warm-up (src/warmup.js).
WARMUP=
WARMUP_PATHS=

# ── Off-site restore (scripts/rebuild-from-offsite.sh) ────────────────────────
# These three are normally INSIDE .env, which is inside the identity archive — so a
# brand-new box could not read the archive that contains them (circular). They are
# bundled here to break that loop: the archive is only useful if a fresh machine can
# reach it without already having the old machine.
# PRIVATE REPO ONLY, like the rest of this file: this secret can read and write the
# backup bucket. If the repo ever becomes public, rotate it first.
BACKUP_WORKER_URL=https://tukuk-backup.fevianbenjo48.workers.dev
BACKUP_UPLOAD_SECRET=42192e3e5bb9e07bd6f974553a0f2894f5a960286c23630f822e0dc0bb2877a6
CLOUDFLARE_ACCOUNT_ID=391d9aa59cfcc5ec44c3d25c855c45cb

# ── Second tunnel: play.tukuk.org / tchat / build (legacy credentials mode) ───
# Its credentials .json is deliberately NOT in git; the identity archive carries it.
# setup-all.sh will 530-warning on play until either the archive is restored or a
# token is minted for this tunnel: cloudflared tunnel token <id> (needs cert.pem).
CF_BUILD_TUNNEL_ID=a3af5bb4-49e5-4c29-b2d6-5fce9d00bce4
