[Unit]
Description=Tukuk Agent (code-server editor + AI build-agent)
Documentation=https://tukuk.org
After=network-online.target tukuk-os.service
Wants=network-online.target
# Tukuk Agent needs the Tukuk-OS engine (/api/agent proxy + MCP), but NOT
# Requires/PartOf — if the search engine dies, the editor MUST still open
# (using a public LLM directly) so users are never locked out of their workspace.
StartLimitIntervalSec=0

[Service]
Type=simple
# The heavy VS Code release is built on the LAPTOP then rsynced here (code-server
# is gitignored; it is an artifact, not source). The VPS only runs the finished build.
User=tukuk-agent
Group=tukuk-agent
# StateDirectory=tukuk-agent → /var/lib/tukuk-agent exists + owned by the User above.
StateDirectory=tukuk-agent
StateDirectoryMode=0750

# /var/lib/tukuk-agent/extensions   → extensions (Cline) + Seed config from
#                                      scripts/build-tukuk-agent.sh
# /var/lib/tukuk-agent/user-data     → VS Code settings/workspace (per user)
# /var/lib/tukuk-agent/projects       → sandboxed workspace where Cline writes/runs
# NOTE: this fork builds into `release/` (KEEP_MODULES=1 → bin/tukuk-agent + bundled
# node). It is rsynced to /opt/tukuk-agent/release. NOT `release-standalone/`.
ExecStart=/opt/tukuk-agent/release/bin/tukuk-agent \
  --bind-addr 127.0.0.1:8443 \
  --auth password \
  --abs-proxy-base-path /agent \
  --extensions-dir /var/lib/tukuk-agent/extensions \
  --user-data-dir /var/lib/tukuk-agent/user-data \
  /var/lib/tukuk-agent/projects

# The editor password is read from EnvironmentFile (--auth password caches
# a .password file inside user-data; see the note below). AGENT_TOKEN is here too
# so the Cline extension (Base URL https://tukuk.org/api/agent/v1) can auth.
EnvironmentFile=-/home/tukuk/.config/tukuk-os/env
Environment=NODE_ENV=production
# Allowed extension origin for calling tukuk.org (CORS on /api/agent/v1).
# The editor is now hosted at tukuk.org/agent (reverse proxy src/agent-editor.js)
# — the MAIN path, using the existing tunnel; agent.tukuk.org is only a later option.
Environment=AGENT_ORIGIN=https://tukuk.org

# --- Never stay dead ---
Restart=always
RestartSec=5

# --- Resource limits (no Docker; native systemd only, like the tukuk-os policy) ---
MemoryMax=1500M
TasksMax=1024
CPUQuota=150%
# VS Code eats FDs (file watchers); give headroom but still sandbox.
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tukuk-agent

# --- hardening (slightly looser than tukuk-os: the editor writes workspace & ext) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# read-only (NOT true): the Cline extension spawns `node /home/tukuk/tukuk-os/mcp/server.js`
# (stdio MCP). It MUST be able to READ that Tukuk-OS source + node_modules, but does
# not need to write there (search/ask call Meilisearch over HTTP localhost:7700;
# scaffold/review return text). So /home is opened READ-ONLY only.
ProtectHome=read-only
ReadWritePaths=/var/lib/tukuk-agent
# Cline runs shell SANDBOXED to the workspace; no broad system access needed.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# DEPLOY NOTE (see plan Phase 3):
#  1. Install a low-priv user:  sudo useradd --system --home /var/lib/tukuk-agent --shell /usr/sbin/nologin tukuk-agent
#  2. place the release:        sudo mkdir -p /opt/tukuk-agent && rsync release/ to /opt/tukuk-agent/release (chown tukuk-agent)
#  3. editor password:          code-server `--auth password` writes/reads
#     /var/lib/tukuk-agent/user-data/.password — set once (see docs) or
#     use `--auth none` BEHIND the cloudflared tunnel if auth is done at the edge.
#  4. Tunnel: cloudflared ingress agent.tukuk.org → http://127.0.0.1:8443
#     (PITFALL: token mode ignores local ingress edits — add the hostname in the
#      Cloudflare dashboard / tunnel config, then reload).
