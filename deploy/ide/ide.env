# Shared configuration for the remote-IDE stack. Read by systemd (EnvironmentFile) AND by
# the shell scripts, which is the only way the two can agree on a display number: a script
# that guesses `:99` while the unit uses `:77` produces "cannot open display" and a very
# confusing half-hour.
#
# Everything here is a plain KEY=value line because systemd's EnvironmentFile does not run
# a shell: no quotes-with-spaces, no ${VAR} expansion inside values, no `export`.

# The X display. 77 rather than 0/99 so a real desktop or another tool on this box can
# never collide with it.
IDE_DISPLAY=:77

# Virtual screen. 1600x900 is deliberate: it is the smallest size that still shows Studio's
# project tree, editor and build pane at once, and every pixel here costs VNC bandwidth on
# the link to the browser. Bigger looks nicer locally and reads worse remotely.
IDE_GEOMETRY=1600x900x24

# VNC listens on loopback only. 5900/6080 are the conventional ports; they are bound to
# 127.0.0.1 by every unit here, so nothing outside the box can reach either one.
IDE_VNC_PORT=5900
IDE_WEB_PORT=6080

# Fractional scale applied by x11vnc on the way out: 3/4 sends 56% of the pixels while
# staying readable on a fast laptop. Set 1/1 for full resolution, 1/2 for a bad link.
IDE_SCALE=1/1

# Where Android Studio was unpacked on this box.
IDE_STUDIO_DIR=/opt/android-studio

# Memory ceiling for the Studio JVM's whole cgroup, enforced by systemd. This is the number
# that protects the SITE: if Studio's JVM (IDE + Gradle + Kotlin daemons) runs away, systemd
# kills the IDE cgroup at 4 GB and tukuk.org keeps serving. Set it above what `free` shows
# as available and the box swaps instead — ide-session.sh checks that before it starts.
#
# CHANGING THIS IS NOT ENOUGH ON ITS OWN. systemd silently drops a ${VAR} it cannot expand
# inside MemoryMax=/CPUQuota= (the unit still starts, just with no ceiling at all), so
# remote-ide-studio.service hard-codes the same numbers instead of reading them from here.
# Edit the value in BOTH places, or run install-remote-ide.sh -- it refuses to finish if the
# two files disagree. This is the one rule in this stack that systemd makes you duplicate.
IDE_MEM_MAX=4G

# CPU share for the same reason. 250% leaves the other cores to the origin, MeiliSearch and
# the tunnel; a Gradle sync just takes longer rather than making the site slow. Same
# hard-coded-twice caveat as IDE_MEM_MAX above.
IDE_CPU_QUOTA=250%

# Minutes with no VNC client attached before remote-ide-idle-stop.service tears the stack
# down. Deliberately short (the Builder's equivalent is 180): this stack costs gigabytes.
# Escape hatch for a long session: sudo touch /etc/tukuk-ide-keep
IDE_IDLE_MIN=15

# Heavy units ide-session.sh may pause to make room, and restores on stop. Comma-separated;
# names that are not installed are skipped silently, so this list works on a rebuilt box.
IDE_PAUSE_UNITS=litert-lm.service
