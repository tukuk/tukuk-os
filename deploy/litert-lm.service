[Unit]
Description=LiteRT-LM OpenAI-compatible server (edge AI tier — tukuk.org internal only)
Documentation=https://github.com/google-ai-edge/LiteRT-LM
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Small CPU-first model (gemma3-1b int4 + embeddinggemma-300m) — designed for
# our 6.8GB server. Bind ONLY 127.0.0.1; the public never touches this port.
# The main AI path stays cloud (src/answer.js rotation); this is the edge tier.
User=tukuk
Group=tukuk
ExecStart=/home/tukuk/.local/bin/litert-lm serve --host 127.0.0.1 --port 8090
Environment=LITERT_LM_HOME=/home/tukuk/.litert-lm

# --- resource limits: node + meilisearch + tukuk-agenteditor matter more ---
# RSS of gemma3-1b int4 during inference is ~1.2–1.8GB; 4200M gives a safe margin.
MemoryMax=4200M
CPUQuota=300%
TasksMax=256
Nice=10

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=litert-lm

# --- hardening (native systemd policy, no Docker) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Read model + registry; write logs only (journal).
ProtectHome=read-only
ReadWritePaths=/home/tukuk/.litert-lm
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target

# NOTE: this unit is NOT enabled by auto-update. It is installed via
# scripts/setup-litert-pilot.sh after the pilot passes its benchmark — see that file.
