{
  "name": "tukuk-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      // Bucket cermin + sandaran: worker fallback (www.tukuk.org) baca dari sini,
      // jadi backup data/ & snapshot mesti tulis ke bucket yang sama.
      "bucket_name": "tukuk-fallback"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
