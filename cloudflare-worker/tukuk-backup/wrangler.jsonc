{
  "name": "tukuk-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      // Mirror + backup bucket: the fallback worker (www.tukuk.org) reads from here,
      // so data/ backups & snapshots must write to the same bucket.
      "bucket_name": "tukuk-fallback"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
