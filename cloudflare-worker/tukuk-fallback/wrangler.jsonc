{
  "name": "tukuk-fallback",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The LAST rung of the ladder: the independent GCP copy of the site, on Cloud Run. The
  // free R2 snapshot is tried first (no egress charge, 6h fresh, no cold start), so this
  // host is only dialed when the snapshot has no copy of the page or R2 itself is failing.
  // A *.run.app hostname needs no DNS record, which is what unblocked this path when the
  // VM + tunnel plan stalled on Zone:DNS. Rebuilt weekly by
  // deploy/gcp/cloudrun/cloudrun-mirror-rebuild.sh. Set this to "off" to demote the ladder
  // to R2 alone — there is no default mirror host any more, on purpose: www.tukuk.org is a
  // zone redirect to the apex, so falling back to it 301s visitors back into a dead origin.
  "vars": {
    "MIRROR_URL": "https://tukuk-mirror-176041010195.us-central1.run.app"
  },
  "r2_buckets": [
    {
      "binding": "FALLBACK_BUCKET",
      "bucket_name": "tukuk-fallback",
      "preview_bucket_name": "tukuk-fallback-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tukuk-os-db",
      "database_id": "86729e04-c708-425e-bb70-78e9b419627e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "6b4121f83fc04c8daf5df901cc2816ae"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "tukuk-os-vectors"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "tukuk-os_engine",
      "dataset": "tukuk-os_data-analytics"
    }
  ],
  "observability": {
    "enabled": true
  }
}
