# Fastfile — automate delivering T Chat to Google Play.
# Usage: `fastlane android upload` (requires fastlane + google-cloud-key.json).
# CLI-free alternative: upload the AAB + paste the metadata text manually in
# the Play Console — see PLAYSTORE.md.
default_platform(:android)

platform :android do
  # Upload the AAB + all metadata (title/desc/keywords/changelog) to the
  # internal track. Change :track to "internal" | "alpha" | "beta" | "production".
  desc "Upload AAB + metadata to Google Play (internal track)"
  lane :upload do
    # This project has NO Gradle — the AAB is generated by scripts/build-apk.sh (aapt2 proto).
    sh("bash scripts/build-apk.sh") unless File.exist?("public/downloads/tukuk-chat.aab")
    aab = "public/downloads/tukuk-chat.aab"
    unless File.exist?(aab)
      UI.user_error!("#{aab} missing after build-apk.sh — check the script/bundletool.")
    end
    supply(
      aab: aab,
      track: "internal",
      release_status: "draft",
      metadata_path: "fastlane/metadata/android"
    )
  end
end
