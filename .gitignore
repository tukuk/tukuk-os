# ─── Dependencies ────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ─── Rahsia: JANGAN commit kunci sebenar ──────────────────────
.env
.env.*
!.env.example
scripts/r2.env

# ─── Meilisearch: pangkalan data indeks ───────────────────────
# State dalam bentuk fail — dijana semula, tidak perlu disimpan.
meili_data/
*.ms

# ─── Snapshot & dump: salinan rizab, jenis binari ─────────────
# Dijana oleh scripts/backup-meili.sh dan deploy/meili-backup.*
snapshots/
dumps/
*.snapshot

# ─── State masa jalan ─────────────────────────────────────────
# Statistik dan cache ditulis semasa servis hidup.
data/
*.log

# ─── Cloudflare Wrangler state (tempatan) ─────────────────────
# Cache/KV/DO miniflare daripada `wrangler dev`; dijana semula, jangan commit.
.wrangler/

# ─── Artifak tetap ───────────────────────────────────────────
# Salinan statik yang tidak perlu dalam kawalan versi.
Tukuk-Os.html

# ─── OS & editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ─── Electron build output ───────────────────────────────────
dist/
datasets/
node_modules/
meili_data/

# ─── Model AI (ONNX/GGUF) ────────────────────────────────────
# Bobot cross-encoder yang dieskport dari Kaggle — binari besar, dimuat turun
# semula oleh scripts/setup, bukan disimpan dalam git.
models/
*.onnx

# ─── Python bytecode (Kaggle kernels) ───
__pycache__/
*.pyc

# APK build (scripts/build-apk.sh) — kekunci edaran self-signed +_work temp; hanya APK final di public/downloads di-commit
apk/build/
apk/*.jks
apk/keystore.env
public/downloads/*.idsig
