# ─── Dependencies ────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ─── Rahsia: JANGAN commit kunci sebenar ──────────────────────
.env
.env.*
!.env.example
scripts/r2.env

# ─── Meilisearch: pangkalan data indeks ───────────────────────
# State dalam bentuk fail — dijana semula, tidak perlu disimpan.
meili_data/
*.ms

# ─── Snapshot & dump: salinan rizab, jenis binari ─────────────
# Dijana oleh scripts/backup-meili.sh dan deploy/meili-backup.*
snapshots/
dumps/
*.snapshot

# ─── State masa jalan ─────────────────────────────────────────
# Statistik dan cache ditulis semasa servis hidup.
data/
*.log

# ─── Cloudflare Wrangler state (tempatan) ─────────────────────
# Cache/KV/DO miniflare daripada `wrangler dev`; dijana semula, jangan commit.
.wrangler/

# ─── Artifak tetap ───────────────────────────────────────────
# Salinan statik yang tidak perlu dalam kawalan versi.
Tukuk-Os.html

# ─── OS & editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ─── Electron build output ───────────────────────────────────
dist/
datasets/
node_modules/
meili_data/

# ─── Model AI (ONNX/GGUF) ────────────────────────────────────
# Bobot cross-encoder yang dieskport dari Kaggle — binari besar, dimuat turun
# semula oleh scripts/setup, bukan disimpan dalam git.
models/
*.onnx

# ─── Python bytecode (Kaggle kernels) ───
__pycache__/
*.pyc

# APK build (scripts/build-apk.sh) — kekunci edaran self-signed +_work temp; hanya APK final di public/downloads di-commit
# apk/build-<slug>/ ialah direktori kerja sementara pembina store; apk/launcher/ dijana gen-launcher-icons.js
apk/build/
apk/build-*/
apk/launcher/
apk/*.jks
apk/keystore.env
# Gradle Android Studio project — build artefacts and machine-local SDK path
apk/app/build/
apk/local.properties
apk/.gradle/
public/downloads/*.idsig
# AAB hanya untuk muat naik Play (tak di-host umum) — boleh dibina semula
public/downloads/*.aab
# APK apl terhasil daripada Tukuk Builder (tukuk-km* = slug apps dinjana pengguna)
# — artefak setempat pada pelayan, boleh dibina semula dengan
# scripts/build-apk.sh <slug>. Jangan commit: fail yang wujud untracked di pelayan
# akan MENOLAK `git merge --ff-only` tukuk-update.service.
public/downloads/tukuk-km*.apk
# Kunci service-account Google Cloud utk fastlane supply — RAHSIA, jangan commit
google-cloud-key.json
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
# Tukuk Agent = fork code-server berhistory sendiri (repo nested, upstream detached)
code-server/
# Tukuk Builder = fork bolt.diy berhistory sendiri (repo nested, remote fevian448)
bolt.diy/

# local safety-net backups (never commit)
.backups/

# Output probe/bench semasa (GPU detection, tier bench) — fail laporan .txt di
# generated/ di-commit sekali-sekala secara eksplisit, direktori ini dijana terus
# oleh kod berjalan di pelayan.
generated/gpu/
