# ─── Dependencies ────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ─── Secrets: do NOT commit real keys ──────────────────────
.env
.env.*
!.env.example
scripts/r2.env

# ─── Meilisearch: index database ───────────────────────
# File-based state — regenerated, no need to store.
meili_data/
*.ms

# ─── Snapshot & dump: backup copies, binary type ─────────────
# Generated by scripts/backup-meili.sh and deploy/meili-backup.*
snapshots/
dumps/
*.snapshot

