# ── Admin login (email + WebAuthn passkey) ────────────────────────────────────
# Only this one email may sign in. All other emails are rejected.
ADMIN_EMAIL=fevianbenjo48@gmail.com
# Bootstrap password — used ONLY once to register the first passkey.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=
# WebAuthn Relying Party. MUST match the real HTTPS domain you deploy to,
# otherwise the browser will refuse to create/use passkeys.
# e.g. site https://tukuk.org  ->  WEBAUTHN_RP_ID=tukuk.org, WEBAUTHN_ORIGIN=https://tukuk.org
WEBAUTHN_RP_NAME=Tukuk-OS Admin
WEBAUTHN_RP_ID=
# Boleh lebih dari satu origin, dipisahkan koma:
# WEBAUTHN_ORIGIN=https://tukuk.org,https://dashboard.tukuk.org
WEBAUTHN_ORIGIN=

# ── Auto-setup server (scripts/setup-all.sh) ─────────────────────────
# Token dari Cloudflare Zero Trust → Tunnels → Create tunnel (format: eyJ...)
# Bila diisi, npm install di server akan auto-pasang & sambung tunnel.
CF_TUNNEL_TOKEN=
# Mod alternatif (tunnel bernama dgn cloudflared tunnel create):
# isi UUID; fail ~/.cloudflared/<UUID>.json mesti wujud pada server.
CF_TUNNEL_ID=
# Token API Cloudflare (Edit Workers + R2 + Zone DNS) untuk auto-deploy
# worker www.tukuk.org & snapshot R2 semasa setup.
CLOUDFLARE_API_TOKEN=

# ── AI Sembang / otak (/ask) ─────────────────────────────────────────
# TIDAK PERLU Ollama. provider.activeBackend() auto-pilih mengikut ROTASI:
#   cloud (SEMUA kunci di bawah dicuba bergilir) → Ollama → ekstraktif (0 kos).
# GABUNG KEDAP: letak lebih dari satu kunci tier percuma serentak. Bila satu
# pembekal HABIS KUOTA (respons 429/"quota"), ia "cooling" seketika (60s had
# seminit / 10min kuota harian) lalu /ask TERUS tukar ke pembekal seterusnya
# yang masih ada kuota. Semua cloud habis → Ollama lokal → ekstraktif.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# xAI/Grok & HuggingFace: SAH tapi perlu kredit berbayar (tiada tier percuma) —
# biarkan kosong melainkan kamu sudah beli kredit.
# XAI_API_KEY=
# HUGGINGFACE_API_KEY=
# Cloudflare Workers AI (tier percuma 10k Neurons/hari) — PERLU KEDUANYA:
# token + account id. CLOUDFLARE_AI_TOKEN boleh pakai CLOUDFLARE_API_TOKEN
# jika token itu mempunyai keizinan Workers AI.
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Susunan rotasi (kiri→kanan). Lalai ikut susunan ini:
# LLM_CLOUD_ORDER=gemini,groq,openrouter,huggingface,xai,cloudflare,ollama-cloud,openai
# Override model setiap pembekal (jika perlu; kosong = lalai tier percuma):
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Ollama Cloud (api.ollama.com): model besar (gpt-oss:20b, gemma4:31b), free tier
# had 5-jam → auto-cool 10 min setiap kali 429, serve bila kuota reset.
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=gpt-oss:20b
# Bajet token untuk CLOUD. Model reasoning (gpt-oss/qwen3/gemini-latest) belanja
# token pada akal dalaman dulu; nilai kecil (≈80) akan kosongkan jawapan mereka.
# LLM_CLOUD_MAX_TOKENS=512
# Paksa satu pembekal di depan (gemini|groq|openai|openrouter|cloudflare|ollama).
# Kosong = auto. 'ollama' paksa lokal sahaja (tiada cloud dicuba).
BRAIN_PROVIDER=
# Ollama lokal (pilihan; abaikan jika guna cloud/ekstraktif):
OLLAMA_HOST=
LLM_CHAIN=
# false untuk lumpuhkan /ask sepenuhnya:
BRAIN_ENABLED=
# Branch git yang mahu digunakan di server (lalai: main)
GIT_BRANCH=main
# Auto-update harian di semua server (1=aktif, 0=mati)
GIT_AUTO_UPDATE=1

# ── T Chat: TURN relay (WebRTC tembus NAT) ────────────────────────────
# Kosong = STUN-sahaja (lalai). Untuk panggilan tersambung pada NAT ketat,
# pasang coturn (lihat deploy/coturn/turnserver.conf) pada hos ber-IP AWAM,
# lalu isi nilai di bawah. Kredensial TURN dijana sah-terhad oleh pelayan.
# TURN_HOST=            # IP/domain awam coturn
# TURN_PORT=3478
# TURN_SECRET=          # mesti sama dengan static-auth-secret coturn
# TURN_TTL=3600         # tempoh sah setiap kredensial (saat)