# ── Admin login (email + WebAuthn passkey) ────────────────────────────────────
# Only this one email may sign in. All other emails are rejected.
ADMIN_EMAIL=fevianbenjo48@gmail.com
# Bootstrap password — used ONLY once to register the first passkey.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=
# WebAuthn Relying Party. MUST match the real HTTPS domain you deploy to,
# otherwise the browser will refuse to create/use passkeys.
# e.g. site https://tukuk.org  ->  WEBAUTHN_RP_ID=tukuk.org, WEBAUTHN_ORIGIN=https://tukuk.org
WEBAUTHN_RP_NAME=Tukuk-OS Admin
WEBAUTHN_RP_ID=
# More than one origin allowed, comma-separated:
# WEBAUTHN_ORIGIN=https://tukuk.org,https://dashboard.tukuk.org
WEBAUTHN_ORIGIN=

# ── Auto-setup server (scripts/setup-all.sh) ─────────────────────────
# Token from Cloudflare Zero Trust → Tunnels → Create tunnel (format: eyJ...)
# When filled in, npm install on the server will auto-install & connect the tunnel.
CF_TUNNEL_TOKEN=
# Alternative mode (named tunnel via cloudflared tunnel create):
# fill UUID; the file ~/.cloudflared/<UUID>.json must exist on the server.
CF_TUNNEL_ID=
# Cloudflare API token (Edit Workers + R2 + Zone DNS) for auto-deploy
# of the www.tukuk.org worker & R2 snapshot during setup.
CLOUDFLARE_API_TOKEN=

# ── AI Chat / brain (/ask) ─────────────────────────────────────────
# NO Ollama needed. provider.activeBackend() auto-selects following the ROTATION:
#   cloud (ALL keys below are tried in turn) → Ollama → extractive (0 cost).
# COMBINED POOL: place more than one free-tier key at once. When one
# provider RUNS OUT OF QUOTA (429/"quota" response), it "cooling" briefly (60s limit
# per minute / 10min daily quota) then /ask SWITCHES straight to the next provider
# that still has quota. All cloud exhausted → local Ollama → extractive.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# xAI/Grok & HuggingFace: VALID but need paid credits (no free tier) —
# leave empty unless you have already bought credits.
# XAI_API_KEY=
# HUGGINGFACE_API_KEY=
# Cloudflare Workers AI (free tier 10k Neurons/day) — NEEDS BOTH:
# token + account id. CLOUDFLARE_AI_TOKEN may reuse CLOUDFLARE_API_TOKEN
# if that token has Workers AI permissions.
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Rotation order (left→right). Default follows this order:
# LLM_CLOUD_ORDER=gemini,groq,openrouter,huggingface,xai,cloudflare,ollama-cloud,openai
# Override model for each provider (if needed; empty = free-tier default):
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Ollama Cloud (api.ollama.com): large models (gpt-oss:20b, gemma4:31b), free tier
# 5-hour limit → auto-cool 10 min on every 429, serve once quota resets.
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=gpt-oss:20b
# Token budget for CLOUD. Reasoning models (gpt-oss/qwen3/gemini-latest) spend
# tokens on internal thinking first; a small value (≈80) will blank out their answers.
# LLM_CLOUD_MAX_TOKENS=512
# Force one provider to the front (gemini|groq|openai|openrouter|cloudflare|ollama).
# Empty = auto. 'ollama' forces local only (no cloud tried).
BRAIN_PROVIDER=
# Local Ollama (optional; ignore if using cloud/extractive):
OLLAMA_HOST=
LLM_CHAIN=
# false to disable /ask entirely:
BRAIN_ENABLED=
# Git branch to use on the server (default: main)
GIT_BRANCH=main
# Daily auto-update on all servers (1=on, 0=off)
GIT_AUTO_UPDATE=1
# Server LAN IP for deploy scripts (deploy/remote-deploy.sh, scripts/deploy-builder.sh,
# scripts/publish-agent.sh). DHCP — address may change (was .100, now .105).
TUKUK_HOST=192.168.8.105

# ── T Chat: TURN relay (WebRTC NAT traversal) ────────────────────────────
# Empty = STUN-only (default). To connect calls on strict NAT,
# install coturn (see deploy/coturn/turnserver.conf) on a host with a PUBLIC IP,
# then fill the values below. TURN credentials are generated time-limited by the server.
# TURN_HOST=            # coturn public IP/domain
# TURN_PORT=3478
# TURN_SECRET=          # must equal coturn static-auth-secret
# TURN_TTL=3600         # validity of each credential (seconds)

# ── T Chat: dedicated domain (isolated messenger space) ─────────────────
# Host treated as the "T Chat dedicated space" by src/server.js. On this host
# the server ONLY serves T Chat assets (chat.html, /api/chat/*, sw.js, icons, APK),
# stricter CSP (frame-ancestors 'none'), X-Robots-Tag noindex, and
# Referrer-Policy no-referrer. Other paths → 302 to tukuk.org.
# To disable the gate, set TCHAT_HOST= (empty).
#
# ENABLE STEPS (Cloudflare Tunnel TOKEN mode — the path cannot be added
# from the local config.yml; needs dashboard/API with a Tunnel+DNS license):
#   1) Zero Trust → Networks → Routes → Add public hostname:
#        hostname  = tchat.tukuk.org
#        connector = 87e7e77f-d6e0-410b-bbcb-dd74ae3a49ae (existing tunnel)
#        service   = HTTP : localhost:3000
#   2) DNS: one proxied CNAME record A tchat.tukuk.org → <tunnel-uuid>.cfargotunnel.com
#      (the dashboard usually creates it automatically after step 1).
#   3) Wait 1–2 minutes; check: curl -I https://tchat.tukuk.org/ → 200 HTML.
TCHAT_HOST=tchat.tukuk.org