ADSENSE_CLIENT=
ADSENSE_ENABLED=
# AdSense approval gate. FALSE = no AdSense on any page (loader, units, Funding Choices all
# read adsenseOn()). Flip to 1 only once the account itself is approved — the review looks at
# the live markup, and units on thin pages is the violation that gets a new account refused.
ADSENSE_APPROVED=
ADSENSE_SLOT_BOTTOM=
ADSENSE_SLOT_IN_ARTICLE=
ADSENSE_SLOT_TOP=

# ── Crawl budget (AdSense "low value content") ─────────────────────────────────
# Item pages of a cluster larger than this are served noindex,follow and dropped from that
# cluster's sitemap; the hub and continent pages stay indexable. Default 1500. The big shards
# (settlements 254k, railway-stations 41k, french-communes 37k…) are what a reviewer samples.
# 1500 → ~132k item pages stay indexable; 250 → ~28k; 0 → hubs only.
# CRAWL_INDEX_MAX_ITEMS=1500

# ── Toolbox crawl budget (/alat) ───────────────────────────────────────────────
# The tool registry is NOT governed by the line above, and must never be. That one exists for
# the encyclopaedia shards - a settlement page is one extract in a repeated layout, and the box
# runs it at 250. A tool page has its own maths, copy and form, so reusing 250 noindexed all
# 1107 tools and removed them from /sitemap-alat.xml. Same shape: item pages of the registry
# beyond this count go noindex,follow and out of the cluster sitemap. Default 1500.
# ALAT_INDEX_MAX_ITEMS=1500

# ── Microsoft Clarity (usage analytics, disclosed in /privacy) ──────────────────
# Optional override. When unset, the built-in project id is used. Toggle off in
# Admin to disable site-wide. The Clarity project ID is public (embedded in the
# tag <script> URL), so it is safe to expose.
# CLARITY_PROJECT_ID=ytshvg0zer
# CLARITY_ENABLED=true

# ── IndexNow (instant URL ping to Bing/Yandex/Naver/Seznam on publish/update) ────
# Opt-in: when INDEXNOW_ENABLED is unset, notifyIndexNow() no-ops (0 requests).
# Ownership is proved by the root key file public/<key>.txt, served at
# https://tukuk.org/<key>.txt (200 OK, confirmed 2026-11-02). Only change the key
# together with regenerating that file.
# INDEXNOW_ENABLED=1
# INDEXNOW_KEY=bd8f0317c5ab4cddb9a3dc62f7ec15ae

# ── Google Tag / Tag Manager (single Google tag, disclosed in /privacy) ─────────
# Optional override. When unset, the built-in container id (GT-PZXWTWW8) is used.
# Toggle off in Admin to disable site-wide. The GTM container ID is public (it is
# baked into the gtm.js <script> URL), so it is safe to expose. Configure Google
# Analytics 4 (G-XXXXXXX) INSIDE the container at tagmanager.google.com — do not
# also set a separate gtag.js, or pageviews get double-counted.
# GTM_CONTAINER_ID=GT-PZXWTWW8
# GTM_ENABLED=true
API_KEY=
CONTENT_CHARS=
CRAWLER_UA=
CRAWL_ALLOW_PRIVATE=
CRAWL_CONCURRENCY=
CRAWL_MAX_BYTES=
CRAWL_MAX_DEPTH=
CRAWL_MAX_PAGES=
CRAWL_MAX_REDIRECTS=
CRAWL_QUEUE_LIMIT=
CRAWL_RESPECT_ROBOTS=
CRAWL_TIMEOUT=
HOST=
LOG_REQUESTS=
MEILI_DB_PATH=
MEILI_HOST=
MEILI_INDEX=
MEILI_MASTER_KEY=
MEILI_TIMEOUT=
RATE_LIMIT_CRAWL_MAX=
RATE_LIMIT_ENABLED=
RATE_LIMIT_SEARCH_MAX=
RATE_LIMIT_TRUST_PROXY=
RATE_LIMIT_WEBSEARCH_MAX=
RATE_LIMIT_WRITE_MAX=
SEARCH_CACHE_SECONDS=
SEARCH_CROP_LENGTH=
SEARCH_DEFAULT_LIMIT=
SEARCH_MAX_LIMIT=
SEARCH_POST_TAG=
SEARCH_PRE_TAG=
SEARCH_TIMEOUT_MS=
SUMMARY_CHARS=
WEBSEARCH_CACHE_SECONDS=
WEBSEARCH_ENABLED=
WEBSEARCH_MAX_RESULTS=
WEBSEARCH_PROVIDER=
WEBSEARCH_TIMEOUT=
WEBSEARCH_UA=

# ── Admin login (email + WebAuthn passkey) ────────────────────────────────────
# Only this one email may sign in. All other emails are rejected.
# The admin login is the address in deploy/env.secrets — this file is an EXAMPLE and
# is published with the repo, so the username half of the admin panel stays out of it.
ADMIN_EMAIL=
# Bootstrap password — used ONLY once to register the first passkey.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=
# WebAuthn Relying Party. MUST match the real HTTPS domain you deploy to,
# otherwise the browser will refuse to create/use passkeys.
# e.g. site https://tukuk.org  ->  WEBAUTHN_RP_ID=tukuk.org, WEBAUTHN_ORIGIN=https://tukuk.org
WEBAUTHN_RP_NAME=Tukuk-OS Admin
WEBAUTHN_RP_ID=
# More than one origin allowed, comma-separated (the admin panel is /admin on the apex, so
# a second hostname for it is not needed and is not configured):
# WEBAUTHN_ORIGIN=https://tukuk.org,https://www.tukuk.org
WEBAUTHN_ORIGIN=

# ── Auto-setup server (scripts/setup-all.sh) ─────────────────────────
# Token from Cloudflare Zero Trust → Tunnels → Create tunnel (format: eyJ...)
# When filled in, npm install on the server will auto-install & connect the tunnel.
CF_TUNNEL_TOKEN=
# Alternative mode (named tunnel via cloudflared tunnel create):
# fill UUID; the file ~/.cloudflared/<UUID>.json must exist on the server.
CF_TUNNEL_ID=
# Cloudflare API token (Edit Workers + R2 + Zone DNS) for auto-deploy
# of the www.tukuk.org worker & R2 snapshot during setup.
CLOUDFLARE_API_TOKEN=

# ── AI Chat / brain (/ask) ─────────────────────────────────────────
# NO Ollama needed. provider.activeBackend() auto-selects following the ROTATION:
#   cloud (ALL keys below are tried in turn) → Ollama → extractive (0 cost).
# COMBINED POOL: place more than one free-tier key at once. When one
# provider RUNS OUT OF QUOTA (429/"quota" response), it "cooling" briefly (60s limit
# per minute / 10min daily quota) then /ask SWITCHES straight to the next provider
# that still has quota. All cloud exhausted → local Ollama → extractive.
GEMINI_API_KEY=
# GROQ IS NOT USED — owner veto. A GROQ_API_KEY left here is ignored at runtime
# (src/brain/provider.js → LLM_DISABLED_PROVIDERS defaults to 'groq'). Do not re-add.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# HuggingFace Inference Providers: token is valid but has 0 credits (HTTP 402).
# Remove it from LLM_CLOUD_ORDER until you buy credits or subscribe PRO.
# When credits are active, add 'huggingface' back to the order.
# XAI_API_KEY=
# HUGGINGFACE_API_KEY=
# Cloudflare Workers AI (free tier 10k Neurons/day) — NEEDS BOTH:
# token + account id. CLOUDFLARE_AI_TOKEN may reuse CLOUDFLARE_API_TOKEN
# if that token has Workers AI permissions.
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Rotation order (left→right). VPS current value (2026-10-30, groq removed):
# LLM_CLOUD_ORDER=gemini-openai,openrouter,cloudflare,ollama-cloud
# Full set of supported names: gemini|gemini-openai|openrouter|cloudflare|ollama-cloud|openai|huggingface|xai|litert
# ('groq' still exists in the registry for tests but is VETOED — it can never enter the order.)
# LLM_DISABLED_PROVIDERS=groq   # hard veto list; default already 'groq'
# Add 'huggingface' back to the order only after Inference Provider credits are active.
# Override model for each provider (if needed; empty = free-tier default):
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=openrouter/free
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Ollama Cloud (api.ollama.com): large models (gpt-oss:20b, gemma4:31b), free tier
# 5-hour limit → auto-cool 10 min on every 429, serve once quota resets.
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=gpt-oss:20b
# Token budget for CLOUD. Reasoning models (gpt-oss/qwen3/gemini-latest) spend
# tokens on internal thinking first; a small value (≈80) will blank out their answers.
# LLM_CLOUD_MAX_TOKENS=512
# Force one provider to the front (gemini|openai|openrouter|cloudflare|ollama).
# Groq is not a legal value — the veto list rejects it.
# Empty = auto. 'ollama' forces local only (no cloud tried).
BRAIN_PROVIDER=
# Local Ollama (optional; ignore if using cloud/extractive):
OLLAMA_HOST=
LLM_CHAIN=
# false to disable /ask entirely:
BRAIN_ENABLED=
# Git branch to use on the server (default: main)
GIT_BRANCH=main
# Daily auto-update on all servers (1=on, 0=off)
GIT_AUTO_UPDATE=1
# Server LAN IP for deploy scripts (deploy/remote-deploy.sh, scripts/deploy-builder.sh,
# scripts/publish-agent.sh). DHCP — address may change (was .100, now .105).
TUKUK_HOST=192.168.8.105

# ── T Chat: TURN relay (WebRTC NAT traversal) ────────────────────────────
# Empty = STUN-only (default). To connect calls on strict NAT,
# install coturn (see deploy/coturn/turnserver.conf) on a host with a PUBLIC IP,
# then fill the values below. TURN credentials are generated time-limited by the server.
# TURN_HOST=            # coturn public IP/domain
# TURN_PORT=3478
# TURN_SECRET=          # must equal coturn static-auth-secret
# TURN_TTL=3600         # validity of each credential (seconds)

# ── T Chat: dedicated domain (isolated messenger space) ─────────────────
# Host treated as the "T Chat dedicated space" by src/server.js. On this host
# the server ONLY serves T Chat assets (chat.html, /api/chat/*, sw.js, icons, APK),
# stricter CSP (frame-ancestors 'none'), X-Robots-Tag noindex, and
# Referrer-Policy no-referrer. Other paths → 302 to tukuk.org.
# To disable the gate, set TCHAT_HOST= (empty).
#
# ENABLE STEPS — one tunnel, added in the dashboard:
#   This box runs ONE connector (cloudflared.service, tunnel c1d8ea0f) in TOKEN mode, and
#   a token-mode tunnel ignores the local ingress: its hostnames come from the dashboard.
#   1) Networks → Routes → Add public hostname
#        hostname  = tchat.tukuk.org
#        connector = c1d8ea0f-b512-487b-b7e7-ad730c24da9e (the only tunnel)
#        service   = HTTP : localhost:3000
#   2) DNS: one proxied CNAME tchat.tukuk.org → c1d8ea0f…cfargotunnel.com.
#      ✅ DONE from the API on 31 Oct 2026 with CLOUDFLARE_DNS_API_TOKEN (same for
#      `play` and `build`) — the dashboard usually creates it automatically after step 1,
#      but step 1 has not been done, so today https://tchat.tukuk.org/ answers a bare
#      cloudflared 404 and never reaches nginx. A DNS record alone is NOT a route.
#   3) Wait 1–2 minutes; check: curl -I https://tchat.tukuk.org/ → 200 HTML.
#   Do NOT create a second tunnel for this. A second connector (the retired a3af5bb4)
#   meant a second credential, a second unit, and a hostname that 530s whenever only the
#   first one is running. play / build / agent ride the same one tunnel the same way.
TCHAT_HOST=tchat.tukuk.org

# ── Live traffic tiles (src/traffic-live.js) ──────────────────────────────────
# Unset = the keyless default (Google raster with the flow overlay burned in).
# To move to a keyed provider, set the template AND the key, then restart:
#   TomTom  TRAFFIC_TILE_URL=https://api.tomtom.com/traffic/map/4/tile/flow/relative/{z}/{x}/{y}.png?key={apiKey}
#   HERE    TRAFFIC_TILE_URL=https://traffic.maps.hereapi.com/v1/tiles/{z}/{x}/{y}/png8?apiKey={apiKey}
# A keyed template with no TRAFFIC_API_KEY is treated as "no provider": the pages
# still render, the layer simply reports itself unavailable instead of 403-ing.
# TRAFFIC_SOURCE_LABEL is the credit line printed under the map.
TRAFFIC_TILE_URL=
TRAFFIC_API_KEY=
TRAFFIC_SOURCE_LABEL=

# ── Boot warm-up (src/warmup.js) ─────────────────────────────────────────────
# After a restart the first visitor to an expensive page pays the cold cache.
# WARMUP=0 disables it; WARMUP_PATHS overrides the built-in list (comma separated).
WARMUP=
WARMUP_PATHS=

# ── Live ships / AIS (src/radar.js, /maps/live) ──────────────────────────────
# /maps/live plots real aircraft (OpenSky, keyless) and real ships at sea. The
# aircraft layer needs NOTHING. Ships come from aisstream.io, which streams public
# AIS but — like every live-AIS source — requires a free token to open its socket.
# Mint one at https://aisstream.io (dashboard → API key), paste it here, restart:
#   AISSTREAM_TOKEN=xxxxxxxx
# With no token the server never opens a socket and the ships layer honestly reads
# "ships not enabled on this server yet" — it is a deliberate no-op, not a failure,
# and the aircraft layer keeps working exactly the same.
# Search-engine site verification meta tags (server.js siteVerifyMeta). Leave
# unset to emit nothing. For a Google Search Console DOMAIN property prefer the DNS TXT
# route instead; the meta tag only verifies a URL-prefix property (https://tukuk.org/).
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
PINTEREST_DOMAIN_VERIFY=
# ── second server: www.tukuk.org static mirror (Cloudflare Pages) ──────────────
# scripts/mirror-export.sh snapshots /alat + static assets and
# scripts/mirror-deploy.sh pushes them to the tukuk-mirror Pages project, which
# serves www.tukuk.org even while this box, the tunnel or Node is down.
# MIRROR_API_TOKEN needs ONLY: Accounts · Cloudflare Pages: Edit.
# With these unset the mirror refresh is a silent no-op (auto-update.sh checks).
# The PRIMARY lane is the GitHub Actions workflow mirror-refresh.yml (same names as
# repo Actions secrets) — it refreshes hourly even when this server is offline; these
# .env entries are the server-side second lane for when root edits .env here.
MIRROR_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MIRROR_PROJECT=tukuk-mirror
